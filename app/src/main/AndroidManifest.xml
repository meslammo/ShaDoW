    <application android:name="com.chaquo.python.android.PyApplication" android:theme="@style/AppTheme" android:label="SHADOW" android:icon="@drawable/shadow_logo" android:roundIcon="@drawable/shadow_logo" android:allowBackup="false" android:supportsRtl="true" android:usesCleartextTraffic="false">
