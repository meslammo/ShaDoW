# OpenAI API keys are server-side secrets; never commit real values.
OPENAI_API_KEY=sk-your-server-side-key
OPENAI_MODEL=gpt-6.1-sol
SHADOW_VISION_MODEL=gpt-6.1-terra
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
PORT=8787

# Optional: configure the 150-Core runtime to call the SHADOW backend image API.
SHADOW_IMAGE_API_BASE_URL=https://your-shadow-backend.example
SHADOW_IMAGE_API_TOKEN=

# Image generation defaults: gpt-image-2.6-flare (fast) or gpt-image-2.6-sunburst (precision).
# GIF output uses output_format=gif, frame_count=2..16, frame_duration_ms=20..2000.
# SVG output is generation-only and requires n=1.
