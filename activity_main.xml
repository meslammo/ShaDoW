<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:fillViewport="true" android:background="#101014" android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:padding="24dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="SHADOW" android:textSize="30sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_width="wrap_content" android:layout_height="wrap_content" />
<TextView android:text="v0.39 • Mobile Gateway Client" android:textColor="#A9A9B3" android:layout_marginBottom="20dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
<EditText android:id="@+id/url" android:hint="Gateway URL (http://host:8787)" android:inputType="textUri" android:text="http://10.0.2.2:8787" android:textColor="#FFFFFF" android:hintTextColor="#777780" android:backgroundTint="#777780" android:layout_width="match_parent" android:layout_height="wrap_content" />
<EditText android:id="@+id/token" android:hint="Gateway token (optional)" android:inputType="textPassword" android:textColor="#FFFFFF" android:hintTextColor="#777780" android:backgroundTint="#777780" android:layout_marginTop="10dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
<LinearLayout android:orientation="horizontal" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/health" android:text="CHECK" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
<Button android:id="@+id/send" android:text="SEND" android:layout_weight="1" android:layout_marginStart="10dp" android:layout_width="0dp" android:layout_height="wrap_content" />
</LinearLayout>
<EditText android:id="@+id/goal" android:hint="Message / goal for SHADOW" android:gravity="top" android:minLines="4" android:textColor="#FFFFFF" android:hintTextColor="#777780" android:backgroundTint="#777780" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
<TextView android:id="@+id/status" android:text="Disconnected" android:textColor="#FFFFFF" android:layout_marginTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout></ScrollView>
